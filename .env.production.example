# ==============================================================================
# YNAB Companion App - GCP Production Environment Template
# ==============================================================================

# Database driver for GCP Cloud SQL
DB_TYPE=postgres

# Option 1: Direct Cloud SQL Proxy sidecar connection (recommended on GKE Autopilot)
DATABASE_URL=postgresql://ynab_user:CHANGE_ME_PASSWORD@127.0.0.1:5432/ynab_companion?sslmode=disable

# Option 2: Parameter-based connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ynab_companion
DB_USER=ynab_user
DB_PASSWORD=CHANGE_ME_PASSWORD
DB_SSL=false
DB_MAX_CONNECTIONS=10

# GCP Cloud SQL Instance Connection Name (format: PROJECT_ID:REGION:INSTANCE_NAME)
INSTANCE_CONNECTION_NAME=your-gcp-project:us-central1:ynab-sql-instance

# AES-256 Encryption key (64 hex characters: generate with `openssl rand -hex 32`)
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Fallback YNAB access token (optional)
YNAB_ACCESS_TOKEN=

# Runtime environment
NODE_ENV=production
PORT=3000
