# ==============================================================================
# YNAB Companion App - Local Environment Configuration
# ==============================================================================

# 32-byte hex key for authenticated AES-256-GCM encryption of local SQLite database.
# If omitted on first startup, the application will automatically generate a secure
# random key and write it to .env.local for you.
ENCRYPTION_KEY=

# Optional: Default YNAB Personal Access Token.
# You can also enter and manage your token via the Settings UI in the app.
# If provided here, it serves as a secure server-level fallback.
YNAB_ACCESS_TOKEN=
