# ==============================================================================
# YNAB Companion App - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Choose database backend: 'postgres' (Google Cloud SQL) or 'sqlite' (Local file)
# If omitted, defaults to 'sqlite' in local environments, or 'postgres' if DATABASE_URL / DB_HOST is set.
DB_TYPE=sqlite

# --- Option A: Full Connection URI (Recommended for Cloud SQL / PostgreSQL) ---
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[require|disable]
# Example for Cloud SQL Auth Proxy sidecar on Kubernetes:
# DATABASE_URL=postgresql://ynab_user:your_password@127.0.0.1:5432/ynab_companion?sslmode=disable
DATABASE_URL=

# --- Option B: Discrete Parameters (Alternative) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ynab_companion
DB_USER=postgres
DB_PASSWORD=
# Set DB_SSL to true if connecting directly to Cloud SQL Public IP without proxy
DB_SSL=false
# Maximum connection pool size (defaults to 10)
DB_MAX_CONNECTIONS=10

# Cloud SQL Instance Connection Name (GCP Project:Region:Instance)
# Used when deploying Cloud SQL Auth Proxy sidecar container in Kubernetes:
# Format: <PROJECT_ID>:<REGION>:<INSTANCE_NAME>
INSTANCE_CONNECTION_NAME=your-gcp-project:us-central1:ynab-sql-instance

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
# 32-byte (64 hex characters) key for authenticated AES-256-GCM encryption of
# financial balances, transaction amounts, and stored tokens at rest.
# In local development, if left blank, a key is auto-generated in .env.local.
# In production on GCP, set this securely via Kubernetes Secret or Google Secret Manager.
ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 3. YNAB API INTEGRATION
# ------------------------------------------------------------------------------
# Optional server-level fallback YNAB Personal Access Token.
# Users can also manage and save their token dynamically via the app UI Settings.
YNAB_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 4. SERVER RUNTIME SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
